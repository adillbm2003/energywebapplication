# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=cms_energy_bm

# In production/staging prefer a single connection string (RDS, Heroku, etc.):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Database TLS ─────────────────────────────────────────────────────────────
# TLS is enabled automatically when NODE_ENV is production or staging. Certificate
# verification is only performed when one of the following is set — without them
# the connection is encrypted but the server is NOT authenticated, and the server
# logs a warning on boot.
#
# Recommended for RDS — download the bundle once:
#   curl -o rds-ca.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# PG_CA_CERT=/var/app/current/rds-ca.pem
#
# Or verify against the system CA store instead:
# PG_SSL_REJECT_UNAUTHORIZED=true

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without a strong, unique
# value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_in_production

# ─── First-run administrator ──────────────────────────────────────────────────
# Used ONLY when the users table is empty. If SEED_ADMIN_PASSWORD is not set, a
# random password is generated and printed to the boot log exactly once.
# There is no hardcoded default password.
SEED_ADMIN_EMAIL=energy@gov.bm
# SEED_ADMIN_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In production set this to your CloudFront domain(s), comma-separated,
# e.g. https://xxxx.cloudfront.net,https://energybm-frontend.s3-website.us-east-2.amazonaws.com
# These values also populate the Content-Security-Policy connect-src directive.
APPROVED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:5174

# The CloudFront domain fronting the public site. Used for /images and /guides
# fallback redirects and allowed as a CSP frame-src for the CMS live preview.
# CLOUDFRONT_URL=https://xxxx.cloudfront.net

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Leave EMPTY for local dev — the Vite dev server proxies /api and /uploads to PORT automatically.
# For production builds set to the deployed backend URL (the Elastic Beanstalk env URL
# or the CloudFront domain that fronts it).
VITE_API_URL=

# ─── File Storage (AWS S3 — required in production; defaults to local ./uploads locally) ─────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# AWS_S3_BUCKET=energybm-uploads

# ─── Email (optional — password reset + contact notifications) ────────────────
# Requires `npm install nodemailer`. Without SMTP_HOST, mail is logged only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bermuda Department of Energy <no-reply@energy.bm>
# CONTACT_NOTIFY_EMAIL=energy@gov.bm

# Public hostname used to build password-reset links in outbound email.
# APP_PUBLIC_DOMAIN=energy.bm

# ─── Production (AWS Elastic Beanstalk) ───────────────────────────────────────
# Set these as EB environment properties (eb setenv ...), NOT in this file:
#   NODE_ENV=production  PORT=8080  DATABASE_URL=postgres://...(RDS)
#   JWT_SECRET=<32-char random>   ← REQUIRED: the server refuses to boot in
#   production without a strong, non-default JWT_SECRET.
